{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ffaa-dw-8832443"
		},
		"ls_sql_dw_ffaa_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_sql_dw_ffaa\""
		},
		"ls_sql_oltp_ffaa_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_sql_oltp_ffaa\""
		},
		"ls_adls_ffaa_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"ls_adls_ffaa\""
		},
		"ls_sql_dw_ffaa_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ffaa-dw-8832443.database.windows.net"
		},
		"ls_sql_dw_ffaa_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_fuerzas_armadas"
		},
		"ls_sql_dw_ffaa_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "josue"
		},
		"ls_sql_oltp_ffaa_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server02-fuerzas-armadas-bolivia.database.windows.net"
		},
		"ls_sql_oltp_ffaa_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp-fuerzas-armadas-bolivia-2"
		},
		"ls_sql_oltp_ffaa_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "userSisGer"
		},
		"ls_adls_ffaa_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saffaadw8832443.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_sql_dw_ffaa')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Conexion al Data Warehouse de Fuerzas Armadas",
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sql_dw_ffaa_properties_typeProperties_server')]",
					"database": "[parameters('ls_sql_dw_ffaa_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_sql_dw_ffaa_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_sql_dw_ffaa_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_sql_oltp_ffaa')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Conexion a la base OLTP fuente de Fuerzas Armadas",
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sql_oltp_ffaa_properties_typeProperties_server')]",
					"database": "[parameters('ls_sql_oltp_ffaa_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_sql_oltp_ffaa_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_sql_oltp_ffaa_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls_ffaa')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_ffaa_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_adls_ffaa_accountKey')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}