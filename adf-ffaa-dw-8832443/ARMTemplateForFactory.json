{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ffaa-dw-8832443"
		},
		"ls_sql_dw_ffaa_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_sql_dw_ffaa\""
		},
		"ls_sql_oltp_ffaa_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_sql_oltp_ffaa\""
		},
		"ls_adls_ffaa_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"ls_adls_ffaa\""
		},
		"ls_sql_dw_ffaa_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ffaa-dw-8832443.database.windows.net"
		},
		"ls_sql_dw_ffaa_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_fuerzas_armadas"
		},
		"ls_sql_dw_ffaa_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "josue"
		},
		"ls_sql_oltp_ffaa_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server02-fuerzas-armadas-bolivia.database.windows.net"
		},
		"ls_sql_oltp_ffaa_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp-fuerzas-armadas-bolivia-2"
		},
		"ls_sql_oltp_ffaa_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "userSisGer"
		},
		"ls_adls_ffaa_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saffaadw8832443.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_sql_dw_ffaa')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Conexion al Data Warehouse de Fuerzas Armadas",
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sql_dw_ffaa_properties_typeProperties_server')]",
					"database": "[parameters('ls_sql_dw_ffaa_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_sql_dw_ffaa_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_sql_dw_ffaa_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_sql_oltp_ffaa')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Conexion a la base OLTP fuente de Fuerzas Armadas",
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sql_oltp_ffaa_properties_typeProperties_server')]",
					"database": "[parameters('ls_sql_oltp_ffaa_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_sql_oltp_ffaa_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_sql_oltp_ffaa_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls_ffaa')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_ffaa_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_adls_ffaa_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_sql_oltp_ffaa')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_sql_oltp_ffaa",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "id_efectivo",
						"type": "int",
						"precision": 10
					},
					{
						"name": "id_especialidad",
						"type": "int",
						"precision": 10
					},
					{
						"name": "id_unidad_actual",
						"type": "int",
						"precision": 10
					},
					{
						"name": "id_rango_actual",
						"type": "int",
						"precision": 10
					},
					{
						"name": "nombre",
						"type": "nvarchar"
					},
					{
						"name": "ci",
						"type": "varchar"
					},
					{
						"name": "fecha_nacimiento",
						"type": "varchar"
					},
					{
						"name": "genero",
						"type": "varchar"
					},
					{
						"name": "departamento_origen",
						"type": "nvarchar"
					},
					{
						"name": "fecha_ingreso",
						"type": "varchar"
					},
					{
						"name": "estado",
						"type": "varchar"
					},
					{
						"name": "salario_mensual",
						"type": "varchar"
					}
				],
				"typeProperties": {
					"schema": "oltp",
					"table": "tbl_efectivos"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_sql_oltp_ffaa')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_adls_bronze_ffaa')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_ffaa",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folderPath": {
						"type": "string"
					},
					"fileName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "@dataset().fileName",
						"folderPath": "@dataset().folderPath",
						"fileSystem": "bronze"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_ffaa')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_bronze_tbl_efectivos')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "copy_tbl_efectivos_to_bronze",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"name": "id_efectivo",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "id_efectivo",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "id_especialidad",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "id_especialidad",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "id_unidad_actual",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "id_unidad_actual",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "id_rango_actual",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "id_rango_actual",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "nombre",
											"type": "String",
											"physicalType": "nvarchar"
										},
										"sink": {
											"name": "nombre",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "ci",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "ci",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "fecha_nacimiento",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "fecha_nacimiento",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "genero",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "genero",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "departamento_origen",
											"type": "String",
											"physicalType": "nvarchar"
										},
										"sink": {
											"name": "departamento_origen",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "fecha_ingreso",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "fecha_ingreso",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "estado",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "estado",
											"type": "String",
											"physicalType": "String"
										}
									},
									{
										"source": {
											"name": "salario_mensual",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "salario_mensual",
											"type": "String",
											"physicalType": "String"
										}
									}
								],
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_sql_oltp_ffaa",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_adls_bronze_ffaa",
								"type": "DatasetReference",
								"parameters": {
									"folderPath": "raw/tbl_efectivos/",
									"fileName": "tbl_efectivos.csv"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_oltp_ffaa')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_bronze_ffaa')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_bronze_copy_all_tables')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "foreach_bronze_tables",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@createArray(\n    'tbl_efectivos',\n    'tbl_especialidades',\n    'tbl_rangos',\n    'tbl_unidades',\n    'tbl_estructura_organizacional',\n    'tbl_movimientos_personal',\n    'tbl_tipos_movimiento',\n    'tbl_operaciones',\n    'tbl_tipos_operacion',\n    'tbl_zonas'\n)",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "copy_table_to_bronze",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": "@concat('SELECT * FROM [oltp].[', item(), ']')",
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_sql_oltp_ffaa",
											"type": "DatasetReference",
											"parameters": {}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_bronze_ffaa",
											"type": "DatasetReference",
											"parameters": {
												"folderPath": "@concat('raw/', item(), '/')",
												"fileName": "@concat(item(), '.csv')"
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_oltp_ffaa')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_bronze_ffaa')]"
			]
		}
	]
}