				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    e.id_efectivo AS id_efectivo_origen,\n    e.nombre,\n    e.ci,\n    TRY_CONVERT(date, e.fecha_nacimiento, 105) AS fecha_nacimiento,\n    e.genero,\n    e.departamento_origen,\n    TRY_CONVERT(date, e.fecha_ingreso, 105) AS fecha_ingreso,\n    e.estado,\n\n    TRY_CONVERT(\n        decimal(12,2),\n        CASE\n            WHEN REPLACE(REPLACE(REPLACE(UPPER(e.salario_mensual), 'BS', ''), ' ', ''), CHAR(9), '') LIKE '%,%.%'\n                THEN REPLACE(REPLACE(REPLACE(REPLACE(UPPER(e.salario_mensual), 'BS', ''), ' ', ''), CHAR(9), ''), ',', '')\n            WHEN REPLACE(REPLACE(REPLACE(UPPER(e.salario_mensual), 'BS', ''), ' ', ''), CHAR(9), '') LIKE '%,%'\n                THEN REPLACE(REPLACE(REPLACE(REPLACE(UPPER(e.salario_mensual), 'BS', ''), ' ', ''), CHAR(9), ''), ',', '.')\n            ELSE REPLACE(REPLACE(REPLACE(UPPER(e.salario_mensual), 'BS', ''), ' ', ''), CHAR(9), '')\n        END\n    ) AS salario_mensual,\n\n    e.id_especialidad AS id_especialidad_origen,\n    esp.nombre AS especialidad_nombre,\n    esp.area AS especialidad_area,\n    e.id_unidad_actual AS id_unidad_actual_origen,\n    e.id_rango_actual AS id_rango_actual_origen\nFROM [oltp].[tbl_efectivos] e\nLEFT JOIN [oltp].[tbl_especialidades] esp\n    ON e.id_especialidad = esp.id_especialidad;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "DELETE FROM dbo.hechos_movimiento_personal;\nDELETE FROM dbo.dim_efectivo;\nDBCC CHECKIDENT ('dbo.dim_efectivo', RESEED, 0);",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
