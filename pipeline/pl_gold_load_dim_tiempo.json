{
	"name": "pl_gold_load_dim_tiempo",
	"properties": {
		"activities": [
			{
				"name": "copy_dim_tiempo",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "WITH fechas AS (\n    SELECT TRY_CONVERT(date, fecha_movimiento, 105) AS fecha\n    FROM [oltp].[tbl_movimientos_personal]\n\n    UNION\n\n    SELECT TRY_CONVERT(date, fecha_inicio, 105) AS fecha\n    FROM [oltp].[tbl_operaciones]\n\n    UNION\n\n    SELECT TRY_CONVERT(date, fecha_fin, 105) AS fecha\n    FROM [oltp].[tbl_operaciones]\n\n    UNION\n\n    SELECT TRY_CONVERT(date, fecha_ingreso, 105) AS fecha\n    FROM [oltp].[tbl_efectivos]\n)\nSELECT DISTINCT\n    CONVERT(int, FORMAT(fecha, 'yyyyMMdd')) AS id_tiempo,\n    fecha,\n    YEAR(fecha) AS anio,\n    MONTH(fecha) AS mes,\n    FORMAT(fecha, 'MMMM', 'es-ES') AS nombre_mes,\n    DATEPART(QUARTER, fecha) AS trimestre,\n    DAY(fecha) AS dia,\n    DATEPART(WEEKDAY, fecha) AS dia_semana,\n    FORMAT(fecha, 'dddd', 'es-ES') AS nombre_dia_semana\nFROM fechas\nWHERE fecha IS NOT NULL;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "DELETE FROM dbo.hechos_movimiento_personal;\nDELETE FROM dbo.hechos_operacion;\nDELETE FROM dbo.dim_tiempo;",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "id_tiempo",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "id_tiempo",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "fecha",
									"type": "Date",
									"physicalType": "date"
								},
								"sink": {
									"name": "fecha",
									"type": "Date",
									"physicalType": "date"
								}
							},
							{
								"source": {
									"name": "anio",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "anio",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "mes",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "mes",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "nombre_mes",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "nombre_mes",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "trimestre",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "trimestre",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "dia",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "dia",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "dia_semana",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "dia_semana",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "nombre_dia_semana",
									"type": "String",
									"physicalType": "nvarchar"
								},
								"sink": {
									"name": "nombre_dia_semana",
									"type": "String",
									"physicalType": "varchar"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_sql_oltp_ffaa",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_dw_dim_tiempo",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}