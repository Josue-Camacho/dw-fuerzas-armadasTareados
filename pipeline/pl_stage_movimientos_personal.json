	"name": "pl_stage_movimientos_personal",
	"properties": {
		"activities": [
			{
				"name": "copy_stg_movimientos_personal",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    id_movimiento AS id_movimiento_origen,\n    id_efectivo AS id_efectivo_origen,\n    id_unidad_destino AS id_unidad_destino_origen,\n    id_rango AS id_rango_origen,\n    id_tipo AS id_tipo_origen,\n\n    TRY_CONVERT(date, fecha_movimiento, 105) AS fecha_movimiento,\n\n    TRY_CONVERT(\n        INT,\n        LEFT(\n            LTRIM(RTRIM(antiguedad_anios)),\n            PATINDEX('%[^0-9]%', LTRIM(RTRIM(antiguedad_anios)) + 'X') - 1\n        )\n    ) AS antiguedad_anios,\n\n    TRY_CONVERT(\n        decimal(12,2),\n        CASE\n            WHEN REPLACE(REPLACE(REPLACE(UPPER(salario_mensual), 'BS', ''), ' ', ''), CHAR(9), '') LIKE '%,%.%'\n                THEN REPLACE(REPLACE(REPLACE(REPLACE(UPPER(salario_mensual), 'BS', ''), ' ', ''), CHAR(9), ''), ',', '')\n            WHEN REPLACE(REPLACE(REPLACE(UPPER(salario_mensual), 'BS', ''), ' ', ''), CHAR(9), '') LIKE '%,%'\n                THEN REPLACE(REPLACE(REPLACE(REPLACE(UPPER(salario_mensual), 'BS', ''), ' ', ''), CHAR(9), ''), ',', '.')\n            ELSE REPLACE(REPLACE(REPLACE(UPPER(salario_mensual), 'BS', ''), ' ', ''), CHAR(9), '')\n        END\n    ) AS salario_mensual,\n\n    observaciones\nFROM [oltp].[tbl_movimientos_personal];",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "DELETE FROM dbo.stg_movimientos_personal;",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
